<Application x:Class="ClawTweaksCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Fluent dark palette for the self-contained WPF executable. -->
            <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <Color x:Key="BgColor">#FF202020</Color>
            <Color x:Key="CardColor">#FF2B2B2B</Color>
            <Color x:Key="FooterColor">#FF252525</Color>
            <Color x:Key="StrokeColor">#FF3A3A3A</Color>
            <Color x:Key="AccentColor">#FF60CDFF</Color>
            <SolidColorBrush x:Key="BgBrush"     Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="CardBrush"   Color="{StaticResource CardColor}" />
            <SolidColorBrush x:Key="FooterBrush" Color="{StaticResource FooterColor}" />
            <SolidColorBrush x:Key="StrokeBrush" Color="{StaticResource StrokeColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="TextBrush"       Color="#FFFFFFFF" />
            <!-- Never below #C8C8C8: anything meant to be READ has to stay legible on the handheld's
                 screen at arm's length. Subtitles and captions use this, so a "slightly softer grey"
                 here is not a cosmetic tweak — it is the difference between a hint and a smudge. -->
            <SolidColorBrush x:Key="SubtleTextBrush" Color="#FFC8C8C8" />
            <SolidColorBrush x:Key="OkBrush"       Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="WarnBrush"     Color="#FFFCE100" />
            <SolidColorBrush x:Key="ErrorBrush"    Color="#FFFF99A4" />

            <!-- Scrollbar red. Deliberately NOT the accent (a light blue): the accent marks what the
                 controller cursor is on, and a scrollbar sharing that colour would read as "this is
                 selected". The scrollbar is furniture, so it gets its own colour and its own name. -->
            <Color x:Key="ScrollThumbColor">#FFE03A46</Color>
            <Color x:Key="ScrollThumbHighlightColor">#FFFF6B75</Color>

            <!-- Apply the Windows UI typeface to XAML- and code-built UI. -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Style>
            <Style TargetType="{x:Type ToolTip}">
                <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            </Style>

            <!-- Focus visual for controller navigation: an accent ring around the focused element.
                 Center is driven with a gamepad on the device itself, where there is no mouse cursor
                 to say where you are — the ring is the ONLY indicator, so every interactive style
                 below sets FocusVisualStyle to it. -->
            <Style x:Key="ControllerFocusVisual">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2" CornerRadius="6"
                                    Margin="-3" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Shared wizard button. -->
            <Style TargetType="Button" x:Key="SetupButton">
                <Setter Property="FocusVisualStyle" Value="{StaticResource ControllerFocusVisual}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#FF3A3A3A" />
                <Setter Property="BorderBrush" Value="#FF505050" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#FF454545" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#FF454545" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.82" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary-action variant. -->
            <Style TargetType="Button" x:Key="SetupButtonAccent" BasedOn="{StaticResource SetupButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#FF0A0C10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- Footer controller action. -->
            <Style TargetType="Button" x:Key="ControllerActionTile">
                <Setter Property="FocusVisualStyle" Value="{StaticResource ControllerFocusVisual}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#FF303030" />
                <Setter Property="BorderBrush" Value="#FF4A4A4A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,5,12,5" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="TileBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TileBorder" Property="Background" Value="#FF3A3A3A" />
                                    <Setter TargetName="TileBorder" Property="BorderBrush" Value="#FF606060" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TileBorder" Property="BorderBrush"
                                            Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="TileBorder" Property="Background" Value="#FF262626" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Touch-friendly WinUI-style checkbox. -->
            <Style TargetType="CheckBox" x:Key="ModernOptionCheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Background" Value="{StaticResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ControllerFocusVisual}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="OptionSurface"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="CheckBoxSurface"
                                            Width="24" Height="24"
                                            CornerRadius="4"
                                            Background="#FF303030"
                                            BorderBrush="#FF8A8A8A"
                                            BorderThickness="2"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="CheckGlyph"
                                                   Text="✓"
                                                   Visibility="Collapsed"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   Foreground="#FF0A0C10"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="0,-1,0,0" />
                                    </Border>
                                    <ContentPresenter Grid.Column="1"
                                                      Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OptionSurface" Property="Background" Value="#FF343434" />
                                    <Setter TargetName="OptionSurface" Property="BorderBrush" Value="#FF606060" />
                                    <Setter TargetName="CheckBoxSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="OptionSurface" Property="Background" Value="#FF292929" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="OptionSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="CheckBoxSurface" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="CheckBoxSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Scrollbars.

                Windows' stock WPF scrollbar is the one piece of chrome in Center that still looks
                like 2006: a grey channel with two arrow buttons at the ends. It is also the wrong
                shape for a handheld - the arrows are mouse targets that nobody hits with a thumb,
                and they eat 34 px of a bar that only needs to show a position.

                So: no repeat buttons, no track chrome, a rounded translucent thumb over a barely
                visible channel. The gradient plus the inner white highlight is what reads as glass -
                a flat red bar looks like a progress indicator instead.
            -->
            <Style x:Key="ScrollThumbStyle" TargetType="{x:Type Thumb}">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Grid x:Name="ThumbRoot" Background="Transparent">
                                <Border x:Name="ThumbBody" CornerRadius="5" Margin="2" Opacity="0.85">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{StaticResource ScrollThumbColor}" Offset="0" />
                                            <GradientStop Color="{StaticResource ScrollThumbHighlightColor}" Offset="0.5" />
                                            <GradientStop Color="{StaticResource ScrollThumbColor}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <!-- The highlight is a child rather than a second gradient stop so it
                                         stays a thin sliver at any thumb length. -->
                                    <Border CornerRadius="5" BorderThickness="1" BorderBrush="#26FFFFFF" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBody" Property="Opacity" Value="1" />
                                    <Setter TargetName="ThumbBody" Property="Margin" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="12" />
                <Setter Property="MinWidth" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Border CornerRadius="6" Background="#14FFFFFF" Margin="4,0,4,0" />
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyle}" MinHeight="28" />
                                    </Track.Thumb>
                                    <!-- The page-up/page-down areas stay, invisible: clicking the track
                                         to jump a page is behaviour, not decoration. -->
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="Height" Value="12" />
                                    <Setter Property="MinHeight" Value="12" />
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="MinWidth" Value="0" />
                        <Setter Property="Height" Value="12" />
                        <Setter Property="MinHeight" Value="12" />
                        <!-- Dimmed at rest. A horizontal bar runs the full width of the screen right
                             under the content, so at full strength it competes with what it is
                             scrolling. Full opacity comes back the moment it is touched, which is the
                             only moment its exact position matters. -->
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Orientation" Value="Horizontal" />
                            <Condition Property="IsMouseOver" Value="True" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Opacity" Value="1" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
