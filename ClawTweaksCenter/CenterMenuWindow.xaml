<Window x:Class="ClawTweaksCenter.CenterMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClawTweaks Center"
        Width="1120" Height="760"
        MinWidth="720" MinHeight="520"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- header -->
            <RowDefinition Height="Auto" />   <!-- main tab strip (Start / Library) -->
            <RowDefinition Height="*" />      <!-- build list / library grid -->
            <RowDefinition Height="Auto" />   <!-- footer action bar -->
        </Grid.RowDefinitions>

        <!-- The user's own background picture, and the scrim that keeps text on top of it readable.
             FIRST CHILDREN AND RowSpan over the whole shell: WPF paints in document order, so
             anything declared here sits behind every other element without a single ZIndex.
             Collapsed until CenterMenuWindow.UserArt.cs has a picture to put in - an empty Image is
             invisible, but a scrim over nothing would dim the window for no reason.
             Stretch is UniformToFill (crop, not distort) - see ApplyBackgroundImage. -->
        <Image x:Name="BackgroundImage" Grid.Row="0" Grid.RowSpan="4"
               Stretch="UniformToFill" Visibility="Collapsed"
               IsHitTestVisible="False" Focusable="False"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <Border x:Name="BackgroundScrim" Grid.Row="0" Grid.RowSpan="4"
                Background="{StaticResource BgBrush}" Opacity="0.65"
                Visibility="Collapsed" IsHitTestVisible="False" Focusable="False" />

        <!-- The same picture again, blurred, and shown ONLY behind the footer.
             Same geometry as the sharp one (RowSpan over everything, UniformToFill) so the two are
             pixel-aligned - a second Image sized to the footer strip alone would show a different
             part of the picture and break at the seam. The OpacityMask is what confines it, and its
             gradient stops are recomputed from the footer's real height in ApplyBackgroundImage.
             BitmapCache because a blur over a 1920px image is not something to recompute per frame. -->
        <Image x:Name="BackgroundBlur" Grid.Row="0" Grid.RowSpan="4"
               Stretch="UniformToFill" Visibility="Collapsed"
               IsHitTestVisible="False" Focusable="False"
               RenderOptions.BitmapScalingMode="LowQuality">
            <Image.Effect>
                <BlurEffect Radius="18" KernelType="Gaussian" RenderingBias="Performance" />
            </Image.Effect>
            <Image.CacheMode>
                <BitmapCache EnableClearType="False" SnapsToDevicePixels="False" />
            </Image.CacheMode>
            <Image.OpacityMask>
                <LinearGradientBrush x:Name="BackgroundBlurMask" StartPoint="0,0" EndPoint="0,1">
                    <GradientStop x:Name="BlurMaskTop" Offset="0.86" Color="#00000000" />
                    <GradientStop x:Name="BlurMaskBottom" Offset="0.86" Color="#FF000000" />
                </LinearGradientBrush>
            </Image.OpacityMask>
        </Image>

        <!-- Header: brand left, device banner right. The two columns are re-laid-out in code
             (UpdateShellLayout) below the narrow breakpoint, where side by side leaves neither
             enough room — hence the names on both children. -->
        <StackPanel x:Name="ShellHeader" Grid.Row="0" Margin="24,16,24,4">
            <Grid x:Name="ShellHeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="BrandBlock" Grid.Column="0" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/branding/ctw-center-logo.png"
                               Height="40" Stretch="Uniform" HorizontalAlignment="Left"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <!-- The Setup/Center tool's own version (ClawTweaksCenter.csproj <Version>) — distinct
                             from the installed ClawTweaks app version in the chip beside it. -->
                        <TextBlock x:Name="SetupVersionLabel" FontSize="12"
                                   Foreground="{StaticResource SubtleTextBrush}"
                                   HorizontalAlignment="Left" Margin="2,3,0,0" />
                    </StackPanel>

                    <!-- Installed ClawTweaks version. It lives in the header rather than on Home
                         because it is true on every screen, and Home had it as the largest element on
                         the page for a fact the user reads once. Filled by RenderInstalledVersionChip. -->
                    <ContentControl x:Name="InstalledVersionChip" Margin="16,0,0,0"
                                    VerticalAlignment="Center" Focusable="False" />
                </StackPanel>

                <ContentControl x:Name="DeviceBanner" Grid.Column="1"
                                Margin="16,0,0,0" VerticalAlignment="Center" Focusable="False" />
            </Grid>
            <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Main tabs. Collapsed until we KNOW ClawTweaks is installed (see RefreshTabStrip):
             before that Center is an installer, and a games library next to a half-finished
             installation is a distraction from the one step that is due. It may appear late; it must
             never appear and then go away again, which reads as a crash. -->
        <Border x:Name="TabStrip" Grid.Row="1" Visibility="Collapsed" Margin="24,0,24,0">
            <!-- DockPanel, not StackPanel: the shoulder hints sit at the far LEFT and far RIGHT of
                 the row with the tabs scrolling between them, which is where the buttons are on the
                 pad. LastChildFill gives the scrolling middle whatever is left. -->
            <DockPanel x:Name="TabStripPanel" LastChildFill="True" VerticalAlignment="Center" />
        </Border>

        <!-- Build list / progress host -->
        <ScrollViewer x:Name="ContentScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="24,12,24,16" Focusable="False">
            <StackPanel x:Name="ContentHost" Focusable="False"
                        MaxWidth="1040" HorizontalAlignment="Stretch" />
        </ScrollViewer>

        <!-- Footer: controller action tiles. WrapPanel, not StackPanel — on a narrow window the four
             actions plus the scroll hint no longer fit on one line, and a StackPanel would clip the
             last of them off-screen instead of wrapping. -->
        <!-- The library owns its whole row: the build list is capped at 1040 DIP for readability,
             and a cover grid wants every pixel the 1200p panel has. Sibling of the scroller rather
             than content inside it, so the two never fight over scrolling. -->
        <Grid x:Name="LibraryRoot" Grid.Row="2" Visibility="Collapsed" />


        <!-- Immersive mode's replacement for the footer. In row 2, NOT in the footer's row 3: row 3
             has to collapse completely so the grid grows into it and the scrollbar reaches the
             bottom edge. An overlay pinned to the bottom of the content takes no layout space. -->
        <TextBlock x:Name="ImmersiveHint" Grid.Row="2" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom"
                   Margin="0,0,0,26" FontSize="12" Opacity="0.35"
                   Foreground="{StaticResource SubtleTextBrush}"
                   Text="Click the right stick to show the button hints" />

        <!-- Three cells, and the outer two are NOT part of the action bar: battery and clock are
             facts about the machine, the chips are what the buttons do right now. In immersive mode
             the chips go and these two stay - see ApplyFooterVisibility. -->
        <Border x:Name="FooterBar" Grid.Row="3" Background="{StaticResource FooterBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FooterBattery" Grid.Column="0"
                           VerticalAlignment="Center" Margin="28,0,8,0"
                           FontSize="12" Foreground="{StaticResource SubtleTextBrush}"
                           Visibility="Collapsed" />

                <WrapPanel x:Name="ActionBar" Grid.Column="1" Orientation="Horizontal"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="12,4,12,4" />

                <TextBlock x:Name="FooterClock" Grid.Column="2"
                           VerticalAlignment="Center" Margin="8,0,28,0"
                           FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
