<Window x:Class="ClawTweaksCenter.InstallCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClawTweaks Center"
        Width="1000" Height="860"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="Black"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- top-left wordmark logo -->
            <RowDefinition Height="*" />      <!-- big centered 16:10 artwork -->
            <RowDefinition Height="Auto" />   <!-- title + fluent icon, under the artwork -->
            <RowDefinition Height="Auto" />   <!-- status + buttons -->
        </Grid.RowDefinitions>

        <!-- Header wordmark, top-left, like the other screens. -->
        <Image Grid.Row="0" Source="pack://application:,,,/Assets/branding/ctw-center-logo.png"
               Height="90" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- 16:10 handheld artwork, centered on black (roughly 2x the previous size). -->
        <Image Grid.Row="1" Source="pack://application:,,,/Assets/branding/ctw-handheld-16-10.png"
               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
               MaxWidth="850" MaxHeight="520"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- Context-sensitive title with a Fluent icon (install/update), under the big logo. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
            <TextBlock x:Name="TitleIcon" Text="&#xE896;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="30"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                       Margin="0,0,14,0" />
            <TextBlock x:Name="TitleText" Text="Install ClawTweaks Center"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,24,0,0">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="15"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"
                       HorizontalAlignment="Center" TextAlignment="Center" Visibility="Collapsed" />
            <!-- Install options. The X chip in the action bar toggles it, because this screen is
                 driven with a gamepad and has no roaming focus model (see PadButton). Mouse and touch
                 still work on the box itself. Ticked by default only on a FIRST install - see the
                 constructor.

                 Scaled to 70% through a LayoutTransform rather than by overriding the style's sizes:
                 the tick box (24x24) and its glyph live inside the control TEMPLATE and cannot be set
                 per instance, so shrinking the font alone would have left a full-size box next to
                 small text. A LayoutTransform takes the layout with it, so the row occupies less
                 height too. The shared style is left alone - this is the only screen that wants a
                 smaller one. -->
            <CheckBox x:Name="DesktopShortcutOption"
                      Style="{StaticResource ModernOptionCheckBox}"
                      Content="Add a desktop icon"
                      IsChecked="True"
                      HorizontalAlignment="Left"
                      MinWidth="320"
                      Margin="0,0,0,14">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                </CheckBox.LayoutTransform>
            </CheckBox>

            <WrapPanel x:Name="ActionBar" Orientation="Horizontal" HorizontalAlignment="Left"
                       Margin="-4,0,0,-4" />
        </StackPanel>
    </Grid>
</Window>
